{
  "version": "2.0.0",
  "tasks": [
    { "label": "build", "type": "shell", "command": "make build", "group": { "kind": "build", "isDefault": true }, "problemMatcher": "$rustc" },
    { "label": "test", "type": "shell", "command": "make test", "group": "test", "problemMatcher": "$rustc" },
    { "label": "lint", "type": "shell", "command": "make lint", "problemMatcher": "$rustc" },
    { "label": "fmt", "type": "shell", "command": "make fmt", "problemMatcher": [] },
    { "label": "ci (all gates)", "type": "shell", "command": "make ci", "problemMatcher": "$rustc" }
  ]
}
